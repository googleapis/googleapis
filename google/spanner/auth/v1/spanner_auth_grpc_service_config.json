{
  "methodConfig": [
    {
      "name": [
        {
          "service": "google.spanner.auth.v1.UsersService"
        }
      ],
      "timeout": "60s",
      "retryPolicy": {
        "initialBackoff": "1s",
        "maxBackoff": "60s",
        "backoffMultiplier": 1.3,
        "retryableStatusCodes": [
          "UNAVAILABLE"
        ]
      }
    }
  ]
}
