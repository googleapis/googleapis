# This build file includes a target for the Ruby wrapper library for
# google-shopping-merchant-lfp.

load(
    "@com_google_googleapis_imports//:imports.bzl",
    "nodejs_gapic_combined_pkg",
    "ruby_cloud_gapic_library",
    "ruby_gapic_assembly_pkg",
)

# This is an API workspace, having public visibility by default makes perfect sense.
package(default_visibility = ["//visibility:public"])

# Export yaml configs.
exports_files(glob(["*.yaml"]))

# Generates a Ruby wrapper client for merchant lfp.
# Ruby wrapper clients are versionless, but are generated from source protos
# for a particular service version, v1 in this case.
ruby_cloud_gapic_library(
    name = "lfp_ruby_wrapper",
    srcs = ["//google/shopping/merchant/lfp/v1:lfp_proto_with_info"],
    extra_protoc_parameters = [
        "ruby-cloud-gem-name=google-shopping-merchant-lfp",
        "ruby-cloud-wrapper-of=v1:0.0",
    ],
    service_yaml = "//google/shopping/merchant/lfp/v1:merchantapi_v1.yaml",
    transport = "grpc+rest",
)

# Open Source package.
ruby_gapic_assembly_pkg(
    name = "google-shopping-merchant-lfp-ruby",
    deps = [
        ":lfp_ruby_wrapper",
    ],
)

nodejs_gapic_combined_pkg(
    name = "google-shopping-merchant-lfp-nodejs",
    default_version = "v1",
    release_level = "stable",
    templates_excludes = [
        "package.json",
        ".OwlBot.yaml",
    ],
    deps = [
        "//google/shopping/merchant/lfp/v1:merchant-lfp-v1-nodejs",
    ],
)
